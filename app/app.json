{
  "expo": {
    "name": "Dragonfly",
    "slug": "dragonfly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "dragonfly",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a1214",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thedragonflycatalyst.dragonfly"
    },
    "android": {
      "package": "com.thedragonflycatalyst.dragonfly",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Dragonfly",
      "themeColor": "#0a1214"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f2f5f4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a1214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a7a70"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dragonfly uses your photos for your profile picture and progress photos.",
          "cameraPermission": "Dragonfly uses your camera for progress photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/dragonfly"
    },
    "extra": {
      "supabaseUrl": "https://fkksaivdznqbfsfsagsj.supabase.co",
      "supabaseKey": "sb_publishable_ME6Xg1mtUBA4994aC0n6Uw_LKsJDTXu",
      "webUrl": "https://thedragonflycatalyst.github.io/dragonfly/"
    }
  }
}
