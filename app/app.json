{
  "expo": {
    "name": "Dragonfly",
    "slug": "dragonfly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "dragonfly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a1214",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thedragonflycatalyst.dragonfly",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.thedragonflycatalyst.dragonfly",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_NUTRITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Dragonfly",
      "themeColor": "#0b0b10"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      ["expo-local-authentication", { "faceIDPermission": "Unlock your Dragonfly account with Face ID." }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f2f5f4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a1214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a7a70",
          "sounds": [
            "./assets/sounds/bell_ring2.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dragonfly uses your photos for your profile picture and progress photos.",
          "cameraPermission": "Dragonfly uses your camera for progress photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Dragonfly uses the camera to scan food barcodes and take meal and progress photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dragonfly uses the microphone to record voice messages in chat."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/dragonfly"
    },
    "extra": {
      "supabaseUrl": "https://fkksaivdznqbfsfsagsj.supabase.co",
      "supabaseKey": "sb_publishable_ME6Xg1mtUBA4994aC0n6Uw_LKsJDTXu",
      "webUrl": "https://thedragonflycatalyst.github.io/dragonfly/",
      "giphyKey": ""
    }
  }
}
