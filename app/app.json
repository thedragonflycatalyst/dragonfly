{
  "expo": {
    "name": "Dragonfly Coach",
    "slug": "dragonfly-coach",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "dragonflycoach",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a1214",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thedragonflycatalyst.coach"
    },
    "android": {
      "package": "com.thedragonflycatalyst.coach",
      "adaptiveIcon": {
        "backgroundColor": "#0a1214",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "thedragonflycatalyst.github.io",
              "pathPrefix": "/dragonfly-coach/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Dragonfly Coach",
      "themeColor": "#0a1214"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f2f5f4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a1214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a7a70"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dragonfly Coach uses your photos for your profile picture and progress photos.",
          "cameraPermission": "Dragonfly Coach uses your camera for progress photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/dragonfly-coach"
    },
    "extra": {
      "supabaseUrl": "https://fkksaivdznqbfsfsagsj.supabase.co",
      "supabaseKey": "sb_publishable_ME6Xg1mtUBA4994aC0n6Uw_LKsJDTXu",
      "webUrl": "https://thedragonflycatalyst.github.io/dragonfly-coach/"
    }
  }
}
